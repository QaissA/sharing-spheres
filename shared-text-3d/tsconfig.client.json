{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "rootDir": "src",
    "outDir": "public/build",
    "verbatimModuleSyntax": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "src/client",
    "src/shared"
  ]
}
